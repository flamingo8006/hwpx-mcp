# hwpx-mcp 환경변수 예시 — 실제 값은 .env에 (git 커밋 X, .gitignore line 35 등록 완료)
#
# 현재 시점(2026-05-21): 이 리포지토리는 secret을 사용하지 않습니다.
# - npm publish: 로컬 `npm login` per-user keychain
# - 코드·테스트·CI: secret 0건
#
# 아래 항목은 향후 HTTP 원격 배포 트랙(mcp.dgist.ac.kr) 대비 placeholder입니다.
# 활성화 시점에 1Password CLI / GitHub Actions secrets / systemd EnvironmentFile 중 선택.

# === HTTP 원격 배포용 (미사용) ===
# MCP_HTTP_PORT=
# MCP_HTTP_HOST=mcp.dgist.ac.kr
# MCP_AUTH_TOKEN=

# === 향후 운영 모니터링용 (미사용) ===
# LOG_LEVEL=info
# TZ=Asia/Seoul
