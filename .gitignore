# OS
.DS_Store

# Dependencies
node_modules/

# Build output
out/
dist/
mcp-server/dist/
mcp-server/node_modules/

# Distribution packaging (skill zip + local-only template copies)
dist-skill/

# Local-only binary backups created during MCP swap
mcp-server/dist.backup-*/

# Local-only skill backups (live skill source is skills/hwpx-document-writer/)
skills/_archived/

# Playwright MCP run artefacts (page/console captures)
.playwright-mcp/

# .mcpb bundle staging (regenerated by scripts/build-mcpb.sh)
mcp-server/.mcpb-stage/

# VSCode extension
*.vsix

# Temporary/debug files
*.tmp
*.bak
.omc/
.claude/
test-output/
mcp-server/test-output/
mcp-server/debug-*
mcp-server/*.mjs
mcp-server/test-*.hwpx
mcp-server/src/test-*.hwpx

# Environment / secrets
.env
.env.local
mcp-server/.env
